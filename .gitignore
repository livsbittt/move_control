# gitignore has no end-of-line comments -- a trailing "# ..." becomes part of
# the pattern. Every comment here is on its own line.

# Python build and bytecode
__pycache__/
# covers .pyc / .pyo / .pyd
*.py[cod]
*.egg
*.egg-info/

# colcon workspace output. The robot builds into dev_ws/wj; these show up here
# only when someone builds inside the source tree.
build/
install/
log/
.colcon/

# Test and local-CI state
.pytest_cache/
# tools/ci/run_tests.sh builds this venv; the robot never uses it
.venv-ci/

# Release bundles from tools/ci/make_bundle.sh. Rebuildable from any commit --
# publish them as GitHub release assets, never as repo content.
dist/

# Robot connection details for tools/deploy/deploy.sh: host, port, ssh key path.
# THIS REPO IS PUBLIC -- committing this file would publish the robot's address.
# Start from tools/deploy/deploy.env.example.
tools/deploy/deploy.local.env

# Simulation and mapping run output (tools/gz). Regenerated per run.
artifacts/

# Agent tooling state, per-machine
.omc/
.claude/settings.local.json

# Editor and OS noise
.DS_Store
*.swp
*~
