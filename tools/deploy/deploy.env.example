# Copy to deploy.local.env and fill in. deploy.local.env is git-ignored on
# purpose: this is a PUBLIC repository, so the robot's address, port and key
# path must never be committed.
#
#   cp tools/deploy/deploy.env.example tools/deploy/deploy.local.env

PINKY_HOST=192.168.0.00            # robot IP or hostname
PINKY_SSH_USER=pinky
PINKY_SSH_PORT=22
# PINKY_SSH_KEY=~/.ssh/id_pinky    # per-operator key; omit to use your ssh agent

# Where the updater scripts live on the robot. Deliberately OUTSIDE the
# versioned source tree, because the updater replaces the symlink that tree
# hangs from and cannot swap out its own directory mid-run.
# PINKY_REMOTE_DEPLOY_DIR=/home/pinky/pinky-deploy
